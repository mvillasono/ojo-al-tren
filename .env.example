# Ojo al Tren — copia este archivo a .env y completa.
# Al navegador (config.js) solo llegan MAPBOX_*, DEMO y la URL del sitio. DATABASE_URL y AUTOR_SAL
# se quedan en el servidor (la API).

# Token PÚBLICO de Mapbox (empieza con "pk."). En mapbox.com → Tokens, restríngelo a tus URLs.
# Vacío = mapa con MapLibre y fondo de CARTO (gratis, sin token).
MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11

# URL pública del sitio, sin "/" al final (canonical, vista previa al compartir y sitemap).
# En Vercel puede quedar vacía: se usa el dominio de producción del proyecto.
PUBLIC_SITE_URL=

# Modo demo con reportes simulados (si | no)
DEMO=no

# Base de datos de los reportes (PostgreSQL, p. ej. Neon). Vacía = en memoria (solo para probar).
DATABASE_URL=
# Sal secreta para los hash del id del navegador y de la IP (un texto al azar largo).
AUTOR_SAL=
